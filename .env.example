# === Claude Auto Trader Configuration ===

# Required: Your Anthropic API key
ANTHROPIC_API_KEY=

# Claude model to use for analysis
CLAUDE_MODEL=claude-sonnet-4-20250514

# Trading pair (supported: BTC/USD, ETH/USD, SOL/USD)
TRADING_PAIR=BTC/USD

# Maximum position size (in base currency units, e.g. BTC)
MAX_POSITION_SIZE=0.01

# Risk limit as percentage of portfolio
RISK_LIMIT_PCT=2.0

# Interval between market checks (seconds)
CHECK_INTERVAL_SEC=60

# Dry run mode (true = no real orders, false = live trading)
DRY_RUN=true

# Exchange API credentials (required only when DRY_RUN=false)
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
